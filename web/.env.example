# Server binding
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ROOT_PATH=

# Reverse proxy / Kubernetes Ingress support
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*
CORS_ORIGINS=*

# Compression engine & limits
COMPRESS_WORKERS=2
MAX_UPLOAD_MB=100
DEFAULT_TARGET_BYTES=1995000
MIN_TARGET_BYTES=100000
MAX_TARGET_BYTES=25000000

# Temporary file storage & auto-cleanup
STORAGE_DIR=/tmp/pdf2mb
FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300

